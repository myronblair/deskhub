[Unit]
Description=Desk Hub web board
After=network-online.target
Wants=network-online.target

[Service]
User=deskhub
EnvironmentFile=/etc/deskhub-web.env
ExecStart=/usr/bin/python3 /opt/deskhub-web/server.py
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
