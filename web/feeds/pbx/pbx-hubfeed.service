[Unit]
Description=Read-only call feed for The Hub
After=postgresql.service
Wants=postgresql.service

[Service]
User=hubfeed
ExecStart=/usr/bin/python3 /opt/hubfeed/pbxfeed.py
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
